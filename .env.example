# =============================================================================
# Quorum — AI board of advisors
# Copy to .env.local for development. .env.local is gitignored; keep it that way.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Project Settings -> API. NEXT_PUBLIC_* values are inlined into the bundle at
# BUILD time — on Cloudflare they must be set as build variables, not only as
# runtime secrets.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. BYPASSES ROW-LEVEL SECURITY. Used by the roster lookup at
# sign-in, /api/health's reachability probe, and the seed script.
SUPABASE_SERVICE_ROLE_KEY=

# Direct database connection, used only by `npm run db:push`. Never in the Worker.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Absolute origin of this deployment. Must match the redirect URL configured
# in Supabase Auth. No fallback in production, on purpose.
APP_URL=http://localhost:3000

# --- The advisors ------------------------------------------------------------
# The Anthropic key. ANTHROPIC_API_KEY is the SDK convention; CLAUDE_API_KEY is
# accepted as an alias. Without it advisors cannot answer and the board cannot
# be convened; /api/health says so.
ANTHROPIC_API_KEY=
# The model every advisor speaks with — private chats, independent views, the
# challenge round and the votes (default claude-opus-5).
# ADVISOR_MODEL=claude-opus-5
# The model that writes the board's synthesis (default claude-opus-5).
# SYNTHESIS_MODEL=claude-opus-5
